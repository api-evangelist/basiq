{
  "opencollection": "1.0.0",
  "info": {
    "name": "Basiq Accounts Transactions API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://au-api.basiq.io/users/:userId/transactions",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "Basiq user ID"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter transactions by date range, account, or category"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all transactions for a user across all accounts with optional filtering."
        },
        {
          "info": {
            "name": "Get Transaction",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://au-api.basiq.io/users/:userId/transactions/:transactionId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "Basiq user ID"
              },
              {
                "name": "transactionId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a specific transaction by ID."
        }
      ]
    }
  ],
  "bundled": true
}