{
  "opencollection": "1.0.0",
  "info": {
    "name": "Basiq Accounts Users API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create User",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://au-api.basiq.io/users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new Basiq user representing an end consumer."
        },
        {
          "info": {
            "name": "Get User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://au-api.basiq.io/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "Basiq user ID"
              }
            ]
          },
          "docs": "Retrieve a user by ID."
        },
        {
          "info": {
            "name": "Delete User",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://au-api.basiq.io/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "Basiq user ID"
              }
            ]
          },
          "docs": "Delete a user and all associated connections and data."
        }
      ]
    }
  ],
  "bundled": true
}