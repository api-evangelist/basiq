{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/basiq/refs/heads/main/json-schema/user.json",
  "title": "User",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Basiq user ID"
    },
    "email": {
      "type": "string"
    },
    "mobile": {
      "type": "string"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "createdDate": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "email"
  ]
}